# HPE Aruba Networking Central MCP Server Configuration
# Copy this file to .env and fill in your actual credentials

# Aruba Central API Base URL
# Available regions:
# - US West: https://apigw-uswest4.central.arubanetworks.com
# - US East: https://apigw-useast2.central.arubanetworks.com
# - EU Central: https://apigw-eucentral3.central.arubanetworks.com
# - APAC: https://apigw-apaceast1.central.arubanetworks.com
ARUBA_CENTRAL_BASE_URL=https://apigw-uswest4.central.arubanetworks.com

# OAuth2 Access Token
# Get this from Aruba Central: System > Platform Integration > API Gateway
ARUBA_CENTRAL_TOKEN=your_access_token_here

# OAuth2 Client ID
ARUBA_CENTRAL_CLIENT_ID=your_client_id_here

# OAuth2 Client Secret
ARUBA_CENTRAL_CLIENT_SECRET=your_client_secret_here

# OAuth2 Refresh Token
ARUBA_CENTRAL_REFRESH_TOKEN=your_refresh_token_here

# HTTP Request Timeout (seconds)
ARUBA_CENTRAL_TIMEOUT=30
